                "description": "The LI-RADS category.",
                "x-fhir-r5": "Coding.code",
                "x-fhir-r6": "Coding.code",
                "x-dicom-sr": "none",
                "x-representation": "core"
              }
            },
            "required": [
              "system",
              "code"
            ],
            "additionalProperties": false,
            "description": "A category the radiologist assigned.",
            "x-fhir-r5": "Observation.component.valueCodeableConcept",
            "x-fhir-r6": "Observation.component.valueCodeableConcept",
            "x-dicom-sr": "none",
            "x-representation": "core"
          },
          "hedged": {
            "const": true,
