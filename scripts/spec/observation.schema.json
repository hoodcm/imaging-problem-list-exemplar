            "x-fhir-r5": "cqf-certainty extension",
            "x-fhir-r6": "cqf-certainty extension",
            "x-dicom-sr": "(111013, DCM, \"Certainty of Impression\") in TID 4002",
            "x-representation": "extension"
          }
        },
        "oneOf": [
          {
            "required": [
              "code"
            ]
          },
          {
            "required": [
              "assessment"
            ]
          }
        ],
        "additionalProperties": false
      },
      "description": "Diagnoses or categories the radiologist attached.",
      "x-fhir-r5": "Observation.component",
      "x-fhir-r6": "Observation.component",
      "x-dicom-sr": "(121073, DCM, \"Impression\")",
      "x-representation": "core"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "The report sentence or sentences the observation comes from.",
      "x-fhir-r5": "Observation.note.text",
      "x-fhir-r6": "Observation.note.text",
      "x-dicom-sr": "(121106, DCM, \"Comment\")",
      "x-representation": "core"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
