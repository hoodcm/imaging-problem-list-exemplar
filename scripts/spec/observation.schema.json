                "x-fhir-r5": "Coding.system",
                "x-fhir-r6": "Coding.system",
                "x-dicom-sr": "none",
                "x-representation": "core"
              },
              "code": {
                "enum": [
                  "LR-1",
                  "LR-2",
                  "LR-3",
                  "LR-4",
                  "LR-5",
                  "LR-M",
                  "LR-TIV",
                  "LR-NC"
