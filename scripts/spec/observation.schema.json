{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoodcm/imaging-problem-list-exemplar/schema/observation.schema.json",
  "title": "IPL observation",
  "description": "One documented assessment of a finding on one examination, as the radiologist stated it. The Exam Finding List and the Imaging Problem List share this definition, and only the IPL adds derived.",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$",
      "description": "The observation's identifier.",
      "x-fhir-r5": "Observation.id",
      "x-fhir-r6": "Observation.id",
      "x-dicom-sr": "none",
      "x-representation": "core"
    },
    "exam_id": {
      "type": "string",
      "minLength": 1,
      "description": "The examination the observation comes from.",
      "x-fhir-r5": "ImagingStudy.identifier",
      "x-fhir-r6": "ImagingStudy.identifier",
      "x-dicom-sr": "none",
      "x-representation": "core"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "description": "The report that holds the observation.",
      "x-fhir-r5": "DiagnosticReport.identifier, whose result references the Observation",
      "x-fhir-r6": "DiagnosticReport.identifier, whose result references the Observation",
      "x-dicom-sr": "none",
      "x-representation": "core"
    },
    "exam_date": {
      "type": "string",
      "format": "date",
      "description": "The examination's date.",
      "x-fhir-r5": "Observation.effectiveDateTime",
      "x-fhir-r6": "Observation.effectiveDateTime",
      "x-dicom-sr": "none",
      "x-representation": "core"
    },
    "exam_modality": {
      "type": "string",
      "minLength": 1,
      "description": "The examination's modality.",
      "x-fhir-r5": "ImagingStudy.modality",
      "x-fhir-r6": "ImagingStudy.modality",
      "x-dicom-sr": "none",
      "x-representation": "core"
    },
    "finding_code": {
      "$ref": "#/$defs/oifm_coding",
      "description": "What the radiologist observed.",
      "x-fhir-r5": "Observation.code",
      "x-fhir-r6": "Observation.code",
      "x-dicom-sr": "(121071, DCM, \"Finding\") in TID 1501",
      "x-representation": "core"
    },
    "anatomic_site": {
      "$ref": "#/$defs/site_coding",
      "description": "Where, as this report states it.",
      "x-fhir-r5": "BodyStructure.includedStructure.structure of the report's BodyStructure, which Observation.bodyStructure references",
      "x-fhir-r6": "BodyStructure.includedStructure.structure of the report's BodyStructure, which Observation.bodyStructure.reference references",
      "x-dicom-sr": "(363698007, SCT, \"Finding Site\") in TID 1419",
      "x-representation": "idr-convention"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "presence": {
          "enum": [
            "present",
            "absent"
          ],
          "description": "Whether the sentence states the finding present or absent.",
          "x-fhir-r5": "Observation.valueCodeableConcept (SNOMED CT 260373001 Detected or 260415000 Not detected)",
          "x-fhir-r6": "Observation.valueCodeableConcept (SNOMED CT 260373001 Detected or 260415000 Not detected)",
          "x-dicom-sr": "(121052, DCM, \"Presence of property\") in TID 1350",
          "x-representation": "core"
        },
        "confidence": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "presence",
              "laterality",
              "chronicity",
              "temporal_status",
              "severity",
              "extent",
              "distribution",
              "integrity",
              "position_status",
              "clinical_context"
            ]
          },
          "additionalProperties": {
            "const": "hedged"
          },
          "minProperties": 1,
          "description": "The attributes the radiologist hedged. An attribute left out is stated definitely.",
          "x-fhir-r5": "cqf-certainty extension on the element it qualifies",
          "x-fhir-r6": "cqf-certainty extension on the element it qualifies",
          "x-dicom-sr": "(111012, DCM, \"Certainty of Finding\") in TID 4104",
          "x-representation": "extension"
        },
        "laterality": {
          "enum": [
            "left",
            "right",
            "bilateral"
          ],
          "description": "The stated side.",
          "x-fhir-r5": "BodyStructure.includedStructure.laterality",
          "x-fhir-r6": "BodyStructure.includedStructure.laterality",
          "x-dicom-sr": "(272741003, SCT, \"Laterality\"), a modifier of Finding Site in TID 1419",
          "x-representation": "core"
        },
        "temporal_status": {
          "description": "The change from prior: the radiologist's comparison of the finding with prior imaging.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "type": "array",
          "items": {
            "enum": [
              "unchanged",
              "new",
              "resolved",
              "larger",
              "smaller",
              "increased_extent",
              "decreased_extent",
              "more_conspicuous",
              "less_conspicuous",
              "increased_complexity",
              "decreased_complexity"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "chronicity": {
          "description": "The chronicity: the radiologist's time-course word.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "type": "array",
          "items": {
            "enum": [
              "acute",
              "subacute",
              "chronic",
              "remote",
              "evolving",
              "resolving",
              "healing",
              "healed"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "measurement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "The stated value.",
                "x-fhir-r5": "Observation.component.valueQuantity.value",
                "x-fhir-r6": "Observation.component.valueQuantity.value",
                "x-dicom-sr": "the NUM content item's numeric value in TID 1501",
                "x-representation": "core"
              },
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "%",
                  "mL"
                ],
                "description": "The stated unit, a UCUM code.",
                "x-fhir-r5": "Observation.component.valueQuantity.code (UCUM)",
                "x-fhir-r6": "Observation.component.valueQuantity.code (UCUM)",
                "x-dicom-sr": "the NUM content item's UCUM units in TID 1501",
                "x-representation": "core"
              },
              "property": {
                "enum": [
                  "height loss",
                  "largest member"
                ],
                "description": "What the value measures, as the sentence states it, absent when the sentence doesn't say.",
                "x-fhir-r5": "Observation.component.code",
                "x-fhir-r6": "Observation.component.code",
                "x-dicom-sr": "none",
                "x-representation": "core"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "description": "The current measurements: the values the report states for this examination.",
          "x-fhir-r5": "Observation.component.valueQuantity",
          "x-fhir-r6": "Observation.component.valueQuantity",
          "x-dicom-sr": "(410668003, SCT, \"Length\"), a NUM measurement in TID 1501",
          "x-representation": "core"
        },
        "prior_measurement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "The stated value.",
                "x-fhir-r5": "Observation.component.valueQuantity.value",
                "x-fhir-r6": "Observation.component.valueQuantity.value",
                "x-dicom-sr": "the NUM content item's numeric value in TID 1501",
                "x-representation": "core"
              },
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "%",
                  "mL"
                ],
                "description": "The stated unit, a UCUM code.",
                "x-fhir-r5": "Observation.component.valueQuantity.code (UCUM)",
                "x-fhir-r6": "Observation.component.valueQuantity.code (UCUM)",
                "x-dicom-sr": "the NUM content item's UCUM units in TID 1501",
                "x-representation": "core"
              },
              "property": {
                "enum": [
                  "height loss",
                  "largest member"
                ],
                "description": "What the value measures, as the sentence states it, absent when the sentence doesn't say.",
                "x-fhir-r5": "Observation.component.code",
                "x-fhir-r6": "Observation.component.code",
                "x-dicom-sr": "none",
                "x-representation": "core"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "description": "The prior measurements: the values the report states the finding had on an earlier examination, which the compiler checks against the entry's previous observation.",
          "x-fhir-r5": "Observation.component.valueQuantity",
          "x-fhir-r6": "Observation.component.valueQuantity",
          "x-dicom-sr": "none",
          "x-representation": "core"
        },
        "severity": {
          "description": "The stated severity.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "enum": [
            "mild",
            "mild_to_moderate",
            "moderate",
            "moderate_to_severe",
            "severe"
          ]
        },
        "extent": {
          "description": "The stated extent.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "distribution": {
          "description": "The stated distribution.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "enum": [
            "diffuse"
          ]
        },
        "aggregate": {
          "description": "The statement covers a collection, such as gallstones.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "const": true
        },
        "features": {
          "description": "Stated descriptive features, as the sentence words them.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "position_status": {
          "description": "The stated position of a device.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "enum": [
            "satisfactory",
            "malpositioned"
          ]
        },
        "clinical_context": {
          "description": "A cause or clinical state the radiologist named for the finding.",
          "x-fhir-r5": "Observation.component",
          "x-fhir-r6": "Observation.component",
          "x-dicom-sr": "none",
          "x-representation": "core",
          "type": "array",
          "items": {
            "$ref": "#/$defs/oifm_coding"
          },
          "minItems": 1
        }
      },
      "required": [
        "presence"
      ],
      "additionalProperties": false,
      "description": "What the sentence states about the finding, in the OIDM annotator's attribute model.",
      "x-fhir-r5": "Observation.value[x] and Observation.component",
      "x-fhir-r6": "Observation.value[x] and Observation.component",
      "x-dicom-sr": "TID 1501 qualitative evaluations",
      "x-representation": "core"
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/$defs/oifm_coding",
            "description": "A diagnosis the radiologist attached, such as cirrhosis.",
            "x-fhir-r5": "Observation.component.valueCodeableConcept",
            "x-fhir-r6": "Observation.component.valueCodeableConcept",
            "x-dicom-sr": "(121073, DCM, \"Impression\")",
            "x-representation": "core"
          },
          "assessment": {
            "type": "object",
            "properties": {
              "system": {
                "const": "ACR LI-RADS v2018",
